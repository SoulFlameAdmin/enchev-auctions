{
  "name": "enchev-auctions",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "prebuild": "node scripts/generate-master-test-task-ids.mjs",
    "build": "next build",
    "start": "next start",
    "verify:env": "node scripts/verify-environment-variables.mjs",
    "verify:env:self-test": "node scripts/verify-environment-variables.mjs --self-test",
    "lint": "node scripts/lint-repository.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node scripts/run-ci-tests.mjs",
    "ci:verify": "npm run lint && npm test && npm run typecheck && npm run build",
    "verify:health": "node scripts/verify-health-endpoints.mjs",
    "verify:health:self-test": "node scripts/verify-health-endpoints.mjs --self-test",
    "verify:apps-web": "node scripts/verify-apps-web.mjs",
    "verify:apps-web:self-test": "node scripts/verify-apps-web.mjs --self-test",
    "verify:apps-api": "node scripts/verify-apps-api.mjs",
    "verify:apps-api:self-test": "node scripts/verify-apps-api.mjs --self-test",
    "verify:apps-realtime": "node scripts/verify-apps-realtime.mjs",
    "verify:apps-realtime:self-test": "node scripts/verify-apps-realtime.mjs --self-test"
  },
  "dependencies": {
    "next": "latest",
    "react": "latest",
    "react-dom": "latest"
  },
  "devDependencies": {
    "@types/node": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "typescript": "latest"
  },
  "workspaces": [
    "apps/*"
  ]
}

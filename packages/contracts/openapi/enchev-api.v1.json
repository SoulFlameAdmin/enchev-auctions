{
  "openapi": "3.1.0",
  "info": {
    "title": "Enchev Auctions HTTP API",
    "version": "0.1.0",
    "description": "Canonical specification of HTTP routes that are implemented in the repository. It is descriptive only and does not create auction authority."
  },
  "jsonSchemaDialect": "https://json-schema.org/draft/2020-12/schema",
  "x-enchev-task": "24.01",
  "x-authority-boundary": "PostgreSQL remains authoritative for auction state, accepted bids, winner selection and final results; this specification is non-authoritative documentation.",
  "servers": [
    {
      "url": "https://enchev-auctions.vercel.app",
      "description": "Canonical production web origin"
    },
    {
      "url": "http://localhost:3000",
      "description": "Local development origin"
    }
  ],
  "paths": {
    "/api/health/web": {
      "get": {
        "operationId": "getWebHealth",
        "summary": "Web health",
        "responses": {
          "200": {
            "$ref": "#/components/responses/HealthyComponent"
          }
        }
      }
    },
    "/api/health/api": {
      "get": {
        "operationId": "getApiHealth",
        "summary": "API health",
        "responses": {
          "200": {
            "$ref": "#/components/responses/HealthyComponent"
          }
        }
      }
    },
    "/api/health/realtime": {
      "get": {
        "operationId": "getRealtimeHealth",
        "summary": "Realtime service readiness",
        "responses": {
          "503": {
            "$ref": "#/components/responses/PendingComponent"
          }
        }
      }
    },
    "/api/health/worker": {
      "get": {
        "operationId": "getWorkerHealth",
        "summary": "Worker service readiness",
        "responses": {
          "503": {
            "$ref": "#/components/responses/PendingComponent"
          }
        }
      }
    },
    "/api/health/redis": {
      "get": {
        "operationId": "getRedisHealth",
        "summary": "Sanitized Redis or Valkey binding health",
        "responses": {
          "200": {
            "description": "Configured binding returned PONG",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RedisHealth"
                }
              }
            },
            "headers": {
              "X-Request-ID": {
                "$ref": "#/components/headers/RequestCorrelationId"
              }
            }
          },
          "503": {
            "description": "Binding is missing or failed the live PING",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RedisHealth"
                }
              }
            },
            "headers": {
              "X-Request-ID": {
                "$ref": "#/components/headers/RequestCorrelationId"
              }
            }
          }
        }
      }
    },
    "/api/health/redis-env": {
      "get": {
        "operationId": "getRedisEnvironmentHealth",
        "summary": "Sanitized Redis-related environment key inventory",
        "responses": {
          "200": {
            "description": "Candidate key names only; values are never exposed",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RedisEnvironmentHealth"
                }
              }
            },
            "headers": {
              "X-Request-ID": {
                "$ref": "#/components/headers/RequestCorrelationId"
              }
            }
          }
        }
      }
    },
    "/api/health/vercel-oidc-management": {
      "get": {
        "operationId": "getVercelOidcManagementHealth",
        "summary": "Sanitized Vercel OIDC management reachability probe",
        "responses": {
          "200": {
            "description": "OIDC token exists and the management request is authorized",
            "headers": {
              "X-Request-ID": {
                "$ref": "#/components/headers/RequestCorrelationId"
              }
            }
          },
          "503": {
            "description": "OIDC token is absent, unauthorized, or management request failed",
            "headers": {
              "X-Request-ID": {
                "$ref": "#/components/headers/RequestCorrelationId"
              }
            }
          }
        }
      }
    },
    "/api/live-auction-clock": {
      "get": {
        "operationId": "getLiveAuctionDemoClock",
        "summary": "Read the server-issued non-authoritative browser-session demo clock",
        "responses": {
          "200": {
            "description": "Demo clock state",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LiveAuctionDemoClock"
                }
              }
            },
            "headers": {
              "X-Request-ID": {
                "$ref": "#/components/headers/RequestCorrelationId"
              }
            }
          }
        }
      },
      "post": {
        "operationId": "postLiveAuctionDemoBid",
        "summary": "Advance the non-authoritative browser-session demo bid feedback",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "action"
                ],
                "properties": {
                  "action": {
                    "const": "bid"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Demo bid feedback",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LiveAuctionDemoClock"
                }
              }
            },
            "headers": {
              "X-Request-ID": {
                "$ref": "#/components/headers/RequestCorrelationId"
              }
            }
          },
          "400": {
            "description": "Invalid JSON or unsupported action",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            },
            "headers": {
              "X-Request-ID": {
                "$ref": "#/components/headers/RequestCorrelationId"
              }
            }
          }
        }
      }
    },
    "/api/enchev-auth/[action]": {
      "get": {
        "operationId": "getBuyerAuthSession",
        "summary": "Check authenticated ENCHEV buyer session, fail-closed without dedicated provider",
        "parameters": [
          {
            "in": "path",
            "name": "action",
            "required": true,
            "schema": {
              "const": "session"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "No-store authentication state, never JWTs or passwords",
            "headers": {
              "X-Request-ID": {
                "$ref": "#/components/headers/RequestCorrelationId"
              }
            }
          },
          "400": {
            "description": "Unsupported auth action",
            "headers": {
              "X-Request-ID": {
                "$ref": "#/components/headers/RequestCorrelationId"
              }
            }
          }
        }
      },
      "post": {
        "operationId": "postBuyerAuthAction",
        "summary": "Dedicated-project buyer sign-up, sign-in or sign-out; same-origin only",
        "parameters": [
          {
            "in": "path",
            "name": "action",
            "required": true,
            "schema": {
              "enum": [
                "sign-up",
                "sign-in",
                "sign-out"
              ]
            }
          }
        ],
        "requestBody": {
          "required": false,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "email": {
                    "type": "string",
                    "format": "email"
                  },
                  "password": {
                    "type": "string",
                    "minLength": 12,
                    "maxLength": 128
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Auth outcome with HttpOnly session cookies; credentials never returned",
            "headers": {
              "X-Request-ID": {
                "$ref": "#/components/headers/RequestCorrelationId"
              }
            }
          },
          "400": {
            "description": "Invalid request",
            "headers": {
              "X-Request-ID": {
                "$ref": "#/components/headers/RequestCorrelationId"
              }
            }
          },
          "401": {
            "description": "Bad credentials",
            "headers": {
              "X-Request-ID": {
                "$ref": "#/components/headers/RequestCorrelationId"
              }
            }
          },
          "403": {
            "description": "Cross-origin POST rejected",
            "headers": {
              "X-Request-ID": {
                "$ref": "#/components/headers/RequestCorrelationId"
              }
            }
          },
          "429": {
            "description": "Rate-limited by identity provider",
            "headers": {
              "X-Request-ID": {
                "$ref": "#/components/headers/RequestCorrelationId"
              }
            }
          },
          "503": {
            "description": "Dedicated project not enabled or identity service unavailable",
            "headers": {
              "X-Request-ID": {
                "$ref": "#/components/headers/RequestCorrelationId"
              }
            }
          }
        }
      }
    },
    "/api/carar-waitlist": {
      "get": {
        "operationId": "getCarArWaitlistMethodGuard",
        "summary": "Reject non-POST CarAR waitlist requests",
        "responses": {
          "405": {
            "description": "Use POST to join the CarAR waitlist",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "ok",
                    "message"
                  ],
                  "properties": {
                    "ok": {
                      "const": false
                    },
                    "message": {
                      "type": "string"
                    }
                  }
                }
              }
            },
            "headers": {
              "X-Request-ID": {
                "$ref": "#/components/headers/RequestCorrelationId"
              }
            }
          }
        }
      },
      "post": {
        "operationId": "postCarArWaitlist",
        "summary": "Join the CarAR launch waitlist using a validated email address",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "email"
                ],
                "properties": {
                  "email": {
                    "type": "string",
                    "format": "email",
                    "maxLength": 254
                  },
                  "website": {
                    "type": "string",
                    "description": "Honeypot field; legitimate clients leave it empty"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Waitlist request accepted or honeypot request safely acknowledged",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OkMessageResponse"
                }
              }
            },
            "headers": {
              "X-Request-ID": {
                "$ref": "#/components/headers/RequestCorrelationId"
              }
            }
          },
          "400": {
            "description": "Invalid request data",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OkMessageResponse"
                }
              }
            },
            "headers": {
              "X-Request-ID": {
                "$ref": "#/components/headers/RequestCorrelationId"
              }
            }
          },
          "403": {
            "description": "Cross-origin request rejected",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OkMessageResponse"
                }
              }
            },
            "headers": {
              "X-Request-ID": {
                "$ref": "#/components/headers/RequestCorrelationId"
              }
            }
          },
          "413": {
            "description": "Request body too large",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OkMessageResponse"
                }
              }
            },
            "headers": {
              "X-Request-ID": {
                "$ref": "#/components/headers/RequestCorrelationId"
              }
            }
          },
          "415": {
            "description": "JSON content type required",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OkMessageResponse"
                }
              }
            },
            "headers": {
              "X-Request-ID": {
                "$ref": "#/components/headers/RequestCorrelationId"
              }
            }
          },
          "429": {
            "description": "Per-client attempt limit reached",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OkMessageResponse"
                }
              }
            },
            "headers": {
              "X-Request-ID": {
                "$ref": "#/components/headers/RequestCorrelationId"
              }
            }
          },
          "502": {
            "description": "Email provider did not confirm acceptance",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OkMessageResponse"
                }
              }
            },
            "headers": {
              "X-Request-ID": {
                "$ref": "#/components/headers/RequestCorrelationId"
              }
            }
          },
          "503": {
            "description": "Email provider configuration is unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OkMessageResponse"
                }
              }
            },
            "headers": {
              "X-Request-ID": {
                "$ref": "#/components/headers/RequestCorrelationId"
              }
            }
          }
        }
      }
    },
    "/api/ea-early-access": {
      "get": {
        "operationId": "getEaEarlyAccessPublic",
        "summary": "Read public E&A early-access state through the dedicated Supabase edge service",
        "responses": {
          "200": {
            "description": "Upstream public early-access response",
            "headers": {
              "X-Request-ID": {
                "$ref": "#/components/headers/RequestCorrelationId"
              }
            }
          },
          "403": {
            "description": "Cross-origin request rejected",
            "headers": {
              "X-Request-ID": {
                "$ref": "#/components/headers/RequestCorrelationId"
              }
            }
          },
          "503": {
            "description": "Dedicated early-access service temporarily unavailable",
            "headers": {
              "X-Request-ID": {
                "$ref": "#/components/headers/RequestCorrelationId"
              }
            }
          }
        }
      },
      "post": {
        "operationId": "postEaEarlyAccessPublic",
        "summary": "Submit public E&A early-access data to the dedicated Supabase edge service",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "description": "Public early-access payload forwarded to the dedicated upstream validator",
                "additionalProperties": true
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Upstream accepted the early-access request",
            "headers": {
              "X-Request-ID": {
                "$ref": "#/components/headers/RequestCorrelationId"
              }
            }
          },
          "400": {
            "description": "Invalid or empty request data",
            "headers": {
              "X-Request-ID": {
                "$ref": "#/components/headers/RequestCorrelationId"
              }
            }
          },
          "403": {
            "description": "Cross-origin request rejected",
            "headers": {
              "X-Request-ID": {
                "$ref": "#/components/headers/RequestCorrelationId"
              }
            }
          },
          "413": {
            "description": "Request body too large",
            "headers": {
              "X-Request-ID": {
                "$ref": "#/components/headers/RequestCorrelationId"
              }
            }
          },
          "415": {
            "description": "JSON content type required",
            "headers": {
              "X-Request-ID": {
                "$ref": "#/components/headers/RequestCorrelationId"
              }
            }
          },
          "503": {
            "description": "Dedicated early-access service temporarily unavailable",
            "headers": {
              "X-Request-ID": {
                "$ref": "#/components/headers/RequestCorrelationId"
              }
            }
          }
        }
      }
    },
    "/api/ea-early-access/admin": {
      "get": {
        "operationId": "getEaEarlyAccessAdmin",
        "summary": "List early-access signups for an authenticated admin session",
        "parameters": [
          {
            "in": "query",
            "name": "page",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 0,
              "maximum": 10000,
              "default": 0
            }
          },
          {
            "in": "query",
            "name": "q",
            "required": false,
            "schema": {
              "type": "string",
              "maxLength": 100
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Paginated early-access signup list",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "ok",
                    "rows",
                    "total",
                    "page",
                    "pageSize"
                  ],
                  "properties": {
                    "ok": {
                      "const": true
                    },
                    "rows": {
                      "type": "array",
                      "items": {
                        "type": "object"
                      }
                    },
                    "total": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "page": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "pageSize": {
                      "const": 50
                    }
                  }
                }
              }
            },
            "headers": {
              "X-Request-ID": {
                "$ref": "#/components/headers/RequestCorrelationId"
              }
            }
          },
          "400": {
            "description": "Invalid page parameter",
            "headers": {
              "X-Request-ID": {
                "$ref": "#/components/headers/RequestCorrelationId"
              }
            }
          },
          "401": {
            "description": "Admin session required",
            "headers": {
              "X-Request-ID": {
                "$ref": "#/components/headers/RequestCorrelationId"
              }
            }
          },
          "503": {
            "description": "Supabase configuration or query unavailable",
            "headers": {
              "X-Request-ID": {
                "$ref": "#/components/headers/RequestCorrelationId"
              }
            }
          }
        }
      }
    },
    "/api/ea-early-access/admin/session": {
      "get": {
        "operationId": "getEaEarlyAccessAdminSession",
        "summary": "Read sanitized early-access admin session state",
        "responses": {
          "200": {
            "description": "Admin session state",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "authenticated",
                    "configured"
                  ],
                  "properties": {
                    "authenticated": {
                      "type": "boolean"
                    },
                    "configured": {
                      "type": "boolean"
                    }
                  }
                }
              }
            },
            "headers": {
              "X-Request-ID": {
                "$ref": "#/components/headers/RequestCorrelationId"
              }
            }
          }
        }
      },
      "post": {
        "operationId": "postEaEarlyAccessAdminSession",
        "summary": "Create an early-access admin session using the configured admin secret",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "password"
                ],
                "properties": {
                  "password": {
                    "type": "string",
                    "maxLength": 512
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Admin session created",
            "headers": {
              "X-Request-ID": {
                "$ref": "#/components/headers/RequestCorrelationId"
              }
            }
          },
          "400": {
            "description": "Invalid request",
            "headers": {
              "X-Request-ID": {
                "$ref": "#/components/headers/RequestCorrelationId"
              }
            }
          },
          "401": {
            "description": "Invalid administrator credential",
            "headers": {
              "X-Request-ID": {
                "$ref": "#/components/headers/RequestCorrelationId"
              }
            }
          },
          "403": {
            "description": "Cross-origin request rejected",
            "headers": {
              "X-Request-ID": {
                "$ref": "#/components/headers/RequestCorrelationId"
              }
            }
          },
          "429": {
            "description": "Too many authentication attempts",
            "headers": {
              "X-Request-ID": {
                "$ref": "#/components/headers/RequestCorrelationId"
              }
            }
          },
          "503": {
            "description": "Admin access is not configured",
            "headers": {
              "X-Request-ID": {
                "$ref": "#/components/headers/RequestCorrelationId"
              }
            }
          }
        }
      },
      "delete": {
        "operationId": "deleteEaEarlyAccessAdminSession",
        "summary": "Clear the early-access admin session cookie",
        "responses": {
          "200": {
            "description": "Admin session cleared",
            "headers": {
              "X-Request-ID": {
                "$ref": "#/components/headers/RequestCorrelationId"
              }
            }
          },
          "403": {
            "description": "Cross-origin request rejected",
            "headers": {
              "X-Request-ID": {
                "$ref": "#/components/headers/RequestCorrelationId"
              }
            }
          }
        }
      }
    },
    "/api/admin/google": {
      "get": {
        "operationId": "beginAdminGoogleOAuth",
        "summary": "Begin administrator-only Google OAuth (PKCE)",
        "responses": {
          "302": {
            "description": "Redirect to Supabase Google authorization endpoint",
            "headers": {
              "X-Request-ID": {
                "$ref": "#/components/headers/RequestCorrelationId"
              }
            }
          }
        }
      }
    },
    "/api/admin/callback": {
      "get": {
        "operationId": "finishAdminGoogleOAuth",
        "summary": "Exchange Google authorization code and verify admin allowlist",
        "responses": {
          "303": {
            "description": "Session established or request denied",
            "headers": {
              "X-Request-ID": {
                "$ref": "#/components/headers/RequestCorrelationId"
              }
            }
          }
        }
      }
    },
    "/api/admin/session": {
      "get": {
        "operationId": "getAdminGoogleSession",
        "summary": "Verify current Google admin session against Supabase Auth",
        "responses": {
          "200": {
            "description": "Allowlisted Google admin session is valid",
            "headers": {
              "X-Request-ID": {
                "$ref": "#/components/headers/RequestCorrelationId"
              }
            }
          },
          "401": {
            "description": "Missing or unapproved session",
            "headers": {
              "X-Request-ID": {
                "$ref": "#/components/headers/RequestCorrelationId"
              }
            }
          }
        }
      }
    },
    "/api/admin/logout": {
      "post": {
        "operationId": "logoutAdminGoogleSession",
        "summary": "Revoke Google admin session and clear protected cookies",
        "responses": {
          "200": {
            "description": "Signed out",
            "headers": {
              "X-Request-ID": {
                "$ref": "#/components/headers/RequestCorrelationId"
              }
            }
          },
          "403": {
            "description": "Cross-site request rejected",
            "headers": {
              "X-Request-ID": {
                "$ref": "#/components/headers/RequestCorrelationId"
              }
            }
          }
        }
      }
    },
    "/api/health/enchev-boundary": {
      "get": {
        "operationId": "getEnchevEnvironmentIsolationPreflight",
        "summary": "Secret-free D003 production-vs-preview configuration validation; never authorizes money or staging writes",
        "responses": {
          "200": {
            "description": "Configuration contract matches environment, subject to external role and provider proof"
          },
          "503": {
            "description": "Missing, mismatched or unknown deployment boundary"
          }
        }
      }
    },
    "/api/buyer/catalog": {
      "get": {
        "operationId": "getVerifiedPublicVehicleCatalogue",
        "summary": "Read only approved publicly visible Enchev vehicle listings from validated environment",
        "responses": {
          "200": {
            "description": "Public verified lot list"
          },
          "503": {
            "description": "Enchev buyer/catalog provider binding not activated"
          }
        }
      }
    },
    "/api/buyer/catalog/[id]": {
      "get": {
        "operationId": "getVerifiedVehicleLot",
        "summary": "Read one approved public vehicle lot by UUID; non-authoritative for auctions",
        "responses": {
          "200": {
            "description": "Lot details"
          },
          "400": {
            "description": "Invalid lot UUID"
          },
          "404": {
            "description": "Lot absent or not approved"
          },
          "503": {
            "description": "Identity/certificate binding not available"
          }
        }
      }
    },
    "/api/buyer/workspace": {
      "get": {
        "operationId": "getAuthenticatedBuyerWorkspace",
        "summary": "Get only signed-in buyer-owned profile, orders, documents and payments, subject to RLS",
        "responses": {
          "200": {
            "description": "Authenticated buyer data"
          },
          "401": {
            "description": "Sign in required"
          },
          "503": {
            "description": "Isolated Enchev identity/records unavailable"
          }
        }
      },
      "patch": {
        "operationId": "patchAuthenticatedBuyerProfile",
        "summary": "Modify only allowed buyer profile fields, never roles or eligibility",
        "responses": {
          "200": {
            "description": "Updated profile"
          },
          "400": {
            "description": "Invalid input"
          },
          "401": {
            "description": "Sign in required"
          },
          "403": {
            "description": "Request origin denied"
          },
          "503": {
            "description": "Update could not be applied"
          }
        }
      }
    },
    "/api/buyer/saved": {
      "post": {
        "operationId": "saveAuthenticatedBuyerLot",
        "summary": "Save published approved lot under current buyer identity",
        "responses": {
          "200": {
            "description": "Lot saved"
          },
          "400": {
            "description": "Invalid input"
          },
          "401": {
            "description": "Sign in required"
          },
          "403": {
            "description": "Request origin denied"
          },
          "422": {
            "description": "Lot is not verified/eligible"
          },
          "503": {
            "description": "Identity provider disabled"
          }
        }
      },
      "delete": {
        "operationId": "removeAuthenticatedBuyerSavedLot",
        "summary": "Remove a saved lot owned by the current authenticated buyer",
        "responses": {
          "200": {
            "description": "Lot removed"
          },
          "400": {
            "description": "Invalid lot"
          },
          "401": {
            "description": "Sign in required"
          },
          "403": {
            "description": "Request origin denied"
          },
          "503": {
            "description": "Storage unavailable"
          }
        }
      }
    },
    "/api/payments/readiness": {
      "get": {
        "operationId": "getBuyerPaymentReadiness",
        "summary": "Informational readiness only: live card payments, deposits and requests are OFF",
        "responses": {
          "200": {
            "description": "Machine-readable payment capabilities, no transaction created"
          }
        }
      }
    },
    "/api/menu-access": {
      "get": {
        "operationId": "getProtectedMenuAccess",
        "summary": "Check signed HTTP-only admin-menu access cookie",
        "responses": {
          "200": {
            "description": "Authorization state, no credentials returned"
          }
        }
      },
      "post": {
        "operationId": "authenticateProtectedMenu",
        "summary": "Rate-limited password-based authorization for restricted menu display",
        "responses": {
          "200": {
            "description": "Authorized menu access cookie issued"
          },
          "400": {
            "description": "Invalid input"
          },
          "401": {
            "description": "Incorrect password"
          },
          "403": {
            "description": "Origin denied"
          },
          "429": {
            "description": "Too many attempts"
          },
          "503": {
            "description": "Menu authorization not configured"
          }
        }
      },
      "delete": {
        "operationId": "revokeProtectedMenuAccess",
        "summary": "Clear protected-menu access cookie",
        "responses": {
          "200": {
            "description": "Access cookie removed"
          },
          "403": {
            "description": "Origin denied"
          }
        }
      }
    }
  },
  "components": {
    "responses": {
      "HealthyComponent": {
        "description": "Component is ready",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ComponentHealth"
            }
          }
        },
        "headers": {
          "X-Request-ID": {
            "$ref": "#/components/headers/RequestCorrelationId"
          }
        }
      },
      "PendingComponent": {
        "description": "Component exists but its backing service is pending",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ComponentHealth"
            }
          }
        },
        "headers": {
          "X-Request-ID": {
            "$ref": "#/components/headers/RequestCorrelationId"
          }
        }
      }
    },
    "schemas": {
      "ComponentHealth": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "ok",
          "component",
          "ready",
          "status",
          "schemaVersion",
          "valuesExposed"
        ],
        "properties": {
          "ok": {
            "type": "boolean"
          },
          "component": {
            "enum": [
              "web",
              "api",
              "realtime",
              "worker"
            ]
          },
          "ready": {
            "type": "boolean"
          },
          "status": {
            "enum": [
              "healthy",
              "service-pending"
            ]
          },
          "schemaVersion": {
            "const": 1
          },
          "valuesExposed": {
            "const": false
          }
        }
      },
      "RedisHealth": {
        "type": "object",
        "required": [
          "ok",
          "configured",
          "status"
        ],
        "properties": {
          "ok": {
            "type": "boolean"
          },
          "configured": {
            "type": "boolean"
          },
          "status": {
            "enum": [
              "pong",
              "redis-binding-ping-failed",
              "missing-redis-binding"
            ]
          },
          "binding": {
            "enum": [
              "tcp-url",
              "upstash-rest",
              "vercel-kv-rest"
            ]
          },
          "tls": {
            "type": "boolean"
          },
          "latencyMs": {
            "type": "integer",
            "minimum": 0
          }
        }
      },
      "RedisEnvironmentHealth": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "ok",
          "candidateKeyCount",
          "candidateKeys",
          "valuesExposed"
        ],
        "properties": {
          "ok": {
            "const": true
          },
          "candidateKeyCount": {
            "type": "integer",
            "minimum": 0
          },
          "candidateKeys": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "valuesExposed": {
            "const": false
          }
        }
      },
      "LiveAuctionDemoClock": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "serverNow",
          "roundEndsAt",
          "durationMs",
          "lotIndex",
          "lotId",
          "scope",
          "auctionAuthority",
          "bidFeedback",
          "priceDelta"
        ],
        "properties": {
          "serverNow": {
            "type": "integer"
          },
          "roundEndsAt": {
            "type": "integer"
          },
          "durationMs": {
            "type": "integer",
            "minimum": 1
          },
          "lotIndex": {
            "type": "integer",
            "minimum": 0
          },
          "lotId": {
            "type": "string"
          },
          "scope": {
            "const": "server-issued-browser-session-demo"
          },
          "auctionAuthority": {
            "const": false
          },
          "bidFeedback": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "enum": [
                  "accepted",
                  "leading",
                  "outbid",
                  "rejected"
                ]
              }
            ]
          },
          "priceDelta": {
            "type": "number"
          }
        }
      },
      "ErrorEnvelope": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "error"
        ],
        "properties": {
          "error": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "code",
              "message"
            ],
            "properties": {
              "code": {
                "type": "string",
                "minLength": 1
              },
              "message": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      },
      "OkMessageResponse": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "ok",
          "message"
        ],
        "properties": {
          "ok": {
            "type": "boolean"
          },
          "message": {
            "type": "string"
          }
        }
      }
    },
    "headers": {
      "RequestCorrelationId": {
        "description": "Request correlation identifier resolved by the API boundary. Valid inbound X-Request-ID values are preserved; missing or invalid values are replaced.",
        "schema": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
        }
      }
    }
  }
}

      "persistentResidencyClaim": false
    },
    {
      "id": "runtime-compute",
      "source": "browser",
      "destination": "Vercel runtime compute",
      "classes": [
        "DC-0",
        "DC-1",
        "DC-2-minimized"
      ],
      "regionStatus": "unpinned",
      "persistentResidencyClaim": false
    },
    {
      "id": "future-authoritative-db",
      "source": "api",
      "destination": "production PostgreSQL",
      "classes": [
        "DC-1",

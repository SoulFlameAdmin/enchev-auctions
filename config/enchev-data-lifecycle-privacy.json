      "persistentResidencyClaim": false
    },
    {
      "id": "future-object-storage",
      "source": "api",
      "destination": "private/public object storage",
      "classes": [
        "DC-0",
        "DC-2",
        "DC-3-minimized"
      ],
      "regionStatus": "not-yet-bound",
      "persistentResidencyClaim": false
    }
  ],
  "greenRules": {
    "inventoryCoversPublicInternalConfidentialRestrictedAndAuthorityData": true,
    "classificationReusesFrozen00_07Model": true,
    "minimizationHasPurposeAndProhibitedFields": true,
    "retentionIsExplicitBySensitivity": true,
    "deletionPreservesImmutableAuthorityAndLegalHolds": true,
    "exportIsSubjectScopedAndExcludesSecrets": true,
    "legalHoldIsAuditableAndDoesNotPermitExtraCollection": true,
    "objectLifecycleIsProviderNeutralAndFailClosed": true,
    "piiRedactionHelperIsImplemented": true,
    "sensitiveAccessEventHelperIsImplemented": true,
    "crossBorderInventoryDoesNotClaimResidencyCompliance": true,
    "backupAlignmentRemainsYellowUntilProviderEvidence": true
  }
}

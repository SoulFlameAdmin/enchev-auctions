  "retention": {
    "DC-0": {
      "mode": "publication-lifecycle",
      "defaultDaysAfterUnpublish": 365,
      "legalOverrideAllowed": true
    },
    "DC-1": {
      "mode": "bounded-operational",
      "defaultDays": 90,
      "legalOverrideAllowed": true
    },
    "DC-2": {
      "mode": "purpose-plus-reviewed-retention",
      "defaultDaysAfterPurposeEnds": 365,
      "legalOverrideRequiredForLongerRetention": true
    },
    "DC-3": {
      "mode": "shortest-necessary-or-provider-policy",
      "defaultDaysAfterPurposeEnds": 30,
      "legalOverrideRequiredForLongerRetention": true,
      "secretValuesUseCredentialExpiry": true
    }
  },
  "deletionAndAnonymization": {
    "directIdentifiers": [
      "name",
      "email",
      "phone",
      "telephone",
      "address",
      "ip_address",
      "device_id"
    ],
    "secretFields": [
      "password",
      "token",
      "refresh_token",
      "api_key",
      "secret",
      "mfa_secret",
      "private_max_bid"
    ],
    "anonymizedReplacement": "[ANONYMIZED]",
    "redactedReplacement": "[REDACTED]",
    "preserveWhenRequired": [
      "legal_hold_reference",
      "immutable_a0_event_identity",
      "security_incident_reference"
    ],
    "rules": [
      "delete raw secrets when their owning credential/session expires",
      "anonymize direct identifiers when deletion is approved and immutable operational history must remain",
      "never mutate immutable A0 event facts merely to simplify deletion",
      "store the minimum subject linkage required for a lawful hold or dispute"
    ]
  },
  "exportWorkflow": {
    "states": [
      "requested",
      "identity-verified",
      "collecting",
      "reviewed",
      "ready",
      "delivered",
      "expired",
      "rejected"
    ],
    "requiresVerifiedSubject": true,
    "exportOnlySubjectScopedData": true,
    "exclude": [
      "credentials",
      "password_hashes",
      "provider_secrets",
      "other_subject_data",
      "internal_security_secrets"
    ],
    "includeProvenance": true,
    "deliveryMustBeTimeLimited": true,
    "authoritativeDataSourcesMustBeEnumerated": true
  },
  "legalHold": {
    "states": [
      "none",
      "active",
      "released"
    ],
    "requiresReason": true,
    "requiresActor": true,
    "requiresTimestamp": true,
    "blocksDeletionWhileActive": true,
    "doesNotPermitExtraCollection": true
  },
  "backupAlignment": {
    "required": true,
    "productionAuthoritativeProviderVerified": false,
    "greenEligible": false,
    "requirements": [
      "backup retention must not silently exceed approved data retention without documented reason",
      "restore procedures must preserve legal holds",
      "expired deleted data must age out of backups according to provider capability and documented schedule"
    ]
  },
  "objectStorageLifecycle": {
    "providerBound": false,
    "greenMeaning": "provider-neutral lifecycle contract exists; provider provisioning remains separate",
    "classes": {
      "public-media": {
        "visibility": "public-after-approval",
        "deleteAfterSourceRemovalDays": 30
      },
      "private-documents": {
        "visibility": "private",
        "signedAccessRequired": true,
        "deleteAfterPurposeEndsDays": 30
      },
      "inspection-evidence": {
        "visibility": "private-until-approved-projection",
        "versioned": true,
        "deleteOnlyAfterRetentionCheck": true
      }
    },
    "orphanCleanupRequired": true,
    "legalHoldOverridesDeletion": true
  },
  "logRedaction": {
    "keyPatterns": [
      "password",
      "passcode",
      "token",
      "secret",
      "authorization",
      "cookie",
      "api_key",
      "apikey",
      "mfa",
      "private_max_bid",
      "kyc_document"
    ],
    "stringPatterns": [
      "email",
      "bearer-token"
    ],
    "replacement": "[REDACTED]",
    "maxDepth": 8
  },
  "sensitiveAccessLogging": {
    "requiredFields": [
      "event_id",
      "occurred_at",
      "actor_id",
      "subject_id",
      "resource_type",
      "resource_id",
      "purpose",
      "sensitivity",
      "action",
      "outcome",
      "correlation_id"
    ],
    "forbiddenFields": [
      "raw_value",
      "document_body",
      "password",
      "token",
      "secret",
      "private_max_bid"
    ],
    "appendOnlyIntent": true
  },
  "crossBorderFlows": [
    {
      "id": "public-cdn",
      "source": "web/api",
      "destination": "global CDN edge",
      "classes": [
        "DC-0"
      ],
      "persistentResidencyClaim": false

        "approved vehicle listing fields",
        "public lot number",
        "public auction schedule"
      ],
      "sensitivity": "DC-0",
      "authority": [
        "A1",
        "A2"
      ],
      "systems": [
        "web",
        "api",
        "cdn"
      ],
      "minimumFields": [
        "lot_id",
        "public_vehicle_facts",
        "public_auction_state"
      ],
      "prohibitedFields": [
        "private_max_bid",
        "identity_documents",
        "session_tokens"
      ]
    },
    {
      "id": "engineering-operations",
      "examples": [
        "health state",

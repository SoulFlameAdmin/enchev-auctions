      ],
      "sensitivity": "DC-1",
      "authority": [
        "A2",
        "A3"
      ],
      "systems": [
        "web",
        "api",
        "worker",
        "observability"
      ],
      "minimumFields": [
        "correlation_id",
        "service",
        "event",
        "status",
        "duration_ms"
      ],
      "prohibitedFields": [
        "password",
        "token",
        "private_max_bid",
        "kyc_document_body"
      ]
    },
    {
      "id": "account-and-support",
      "examples": [

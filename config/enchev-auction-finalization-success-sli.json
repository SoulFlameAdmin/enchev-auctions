{
  "taskId": "27.06",
  "name": "Auction finalization success SLI",
  "version": 1,
  "scope": "measurement-contract-only",
  "targetOwnershipTask": "27.07",
  "eventRegistrySource": "config/enchev-websocket-event-registry.json",
  "authoritativeAuctionSource": "postgresql",
  "telemetryMayMutateAuctionState": false,
  "runtimeFinalizationImplemented": false,
  "indicator": {
    "name": "auction_finalization_success_ratio",

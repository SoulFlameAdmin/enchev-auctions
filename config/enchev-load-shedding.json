{
  "taskId": "27.13",
  "name": "Load-shedding rules",
  "version": 1,
  "status": "initial-provisional-policy",
  "scope": "reliability-admission-control-policy",
  "sources": ["27.08", "27.09", "27.10", "27.11", "27.12"],
  "reviewPolicy": {
    "rulesAreMeasuredProductionBehavior": false,
    "rulesAreInitialEngineeringPolicy": true,
    "runtimeActivationClaimed": false,
    "changeRequiresEvidenceAndApproval": true
  },
  "principles": {
    "shedOptionalLoadBeforeCriticalAuctionLoad": true,
    "rejectBeforeAuthoritativeMutation": true,
    "neverReturnSuccessForShedAuthoritativeCommand": true,
    "neverDropAlreadyAcceptedAuthoritativeState": true,
    "sheddingMustBeObservableAndAuditable": true,
    "sheddingMustBeFairAndNonDiscriminatory": true
  },
  "trafficClasses": [
    {
      "id": "optional",
      "priority": 4,
      "examples": ["optional_enrichment", "recommendation_refresh", "noncritical_analytics", "best_effort_notifications"],
      "firstToShed": true
    },
    {
      "id": "noncritical_read",
      "priority": 3,
      "examples": ["noncritical_catalog_refresh", "optional_search_enrichment"],
      "firstToShed": false
    },
    {
      "id": "recovery_read",
      "priority": 2,
      "examples": ["authoritative_reconnect_baseline", "critical_state_refetch"],
      "firstToShed": false
    },
    {
      "id": "critical_authoritative",
      "priority": 1,
      "examples": ["bid_admission", "auction_finalization", "authorization", "eligibility"],
      "firstToShed": false
    }
  ],
  "authoritativeCommandSemantics": {
    "bidAdmissionDecisionOccursBeforeMutation": true,
    "shedBidMustReturnExplicitFailure": true,
    "shedBidMayNotBeRecordedAsAccepted": true,
    "unknownBidOutcomeRequiresAuthoritativeRead": true,
    "retryPolicySourceTask": "27.10",
    "finalizationMayNotBeSilentlyDropped": true,
    "alreadyCommittedStateMayNotBeRolledBackByShedding": true
  },
  "fairness": {
    "noUserSpecificPreferentialAdmission": true,
    "noPricingTierPreferentialBidAdmission": true,
    "noGeographicPreferentialBidAdmission": true,
    "noOpaqueRandomBidDropping": true,
    "sameClassUsesDeterministicPolicy": true,
    "policyDecisionMustBeExplainableFromTelemetryAndClass": true
  },
  "activationSemantics": {
    "capacitySignalSourceTask": "27.11",
    "gracefulDegradationSourceTask": "27.12",
    "errorBudgetSourceTask": "27.08",
    "latencyTimeoutSourceTask": "27.09",
    "capacityThresholdsArePlanningSignalsOnly": true,
    "automaticActivationRequiresCertifiedCapacityAndVerifiedRuntime": true,
    "thisTaskDoesNotClaimAutomaticRuntimeActivation": true,
    "thisTaskDefinesPriorityAndSafetyRulesNotNewCapacityThresholds": true
  },
  "responseSemantics": {
    "explicitRetryableOverloadResponseRequiredWhereRetryIsSafe": true,
    "retryAfterMayOnlyBeEmittedWhenAuthoritativelyKnown": true,
    "retryAfterMustNotBeInvented": true,
    "validationPermissionAndPermanentFailuresRemainNonRetryable": true,
    "telemetryMustRecordClassDecisionAndReason": true
  },
  "recoverySemantics": {
    "restoreHigherPriorityTrafficBeforeOptionalTraffic": true,
    "recoveryRequiresPressureCleared": true,
    "recoveryRequiresHealthEvidence": true,
    "recoveryMustAvoidFlapping": true,
    "optionalTrafficRestoredProgressively": true
  },
  "downstreamOwnership": {
    "scalingRunbookTask": "27.14"
  },
  "authority": {
    "authoritativeAuctionSource": "postgresql",
    "loadSheddingPolicyMayMutateAuctionState": false,
    "loadSheddingPolicyMayChooseWinner": false,
    "loadSheddingPolicyMayCreateAcceptedBid": false,
    "realtimeProjectionAuthoritative": false
  },
  "guardrails": {
    "noSilentAuthoritativeCommandDrop": true,
    "noFakeSuccess": true,
    "noCapacityCertificationInThisTask": true,
    "noScalingRunbookInThisTask": true,
    "noProviderSpecificShortcut": true,
    "noMeasuredProductionBehaviorClaim": true
  }
}

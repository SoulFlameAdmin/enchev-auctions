      "method": "GET",
      "path": "/api/enchev-auth/[action]",
      "operationId": "getBuyerAuthSession",
      "responseCodes": [
        "200",
        "400"
      ],
      "requestBodyRequired": false
    },
    {
      "method": "GET",
      "path": "/api/etap1/[action]",

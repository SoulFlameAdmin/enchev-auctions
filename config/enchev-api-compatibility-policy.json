{
  "version": 1,
  "task": "24.10",
  "title": "Deprecation/backward-compatibility policy",
  "compatibilityLine": "v1",
  "openApiPath": "packages/contracts/openapi/enchev-api.v1.json",
  "endpointInventoryPath": "config/enchev-api-endpoint-inventory.json",
  "authorityBoundary": "Compatibility governance is descriptive only. PostgreSQL remains authoritative for auction state, accepted bids, winner selection and final results.",
  "breakingChangeRule": "Published v1 operations must not be removed, renamed, lose previously documented response status codes, or make an optional request body required. Breaking changes require a new compatibility line.",
  "deprecation": {
    "minimumNoticeDays": 90,
    "requiredFlag": "deprecated",
    "metadataExtension": "x-enchev-deprecation",
    "requiredMetadataFields": [
      "announcedOn",
      "sunsetNotBefore",
      "replacementOperationId",
      "reason"
    ]
  },
  "protectedOperations": [

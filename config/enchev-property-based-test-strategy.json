{
  "taskId": "25.05",
  "name": "Property-based test strategy",
  "scope": [
    "domain-invariant-properties",
    "serialization-roundtrip-properties",
    "boundary-and-range-properties",
    "state-transition-properties"
  ],
  "principles": {
    "invariantDriven": true,
    "generatedInputs": true,
    "deterministicSeedSupport": true,
    "shrinkingRequiredWhenSupported": true,
    "productionIndependent": true,
    "negativePropertyCasesRequired": true

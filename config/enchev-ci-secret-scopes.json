{
  "version": 1,
  "environment": "ci-verification",
  "workflow": ".github/workflows/verify-enchev-web.yml",
  "secretNames": [
    "AIVEN_TOKEN",
    "DIGITALOCEAN_ACCESS_TOKEN",
    "KV_REST_API_TOKEN",
    "KV_REST_API_URL",
    "RAILWAY_TOKEN",
    "REDIS_CLOUD_API_KEY",
    "REDIS_CLOUD_SECRET_KEY",
    "REDIS_URL",
    "RENDER_API_KEY",
    "UPSTASH_API_KEY",
    "UPSTASH_EMAIL",
    "UPSTASH_REDIS_REST_TOKEN",
    "UPSTASH_REDIS_REST_URL",
    "VERCEL_TOKEN"
  ],
  "rules": {
    "pullRequestVerificationMustBeSecretFree": true,
    "secretJobMustRunOnlyOnTrustedMainPush": true,
    "environmentScopeRequired": true,
    "secretValuesMustNeverBeLoggedOrReadByVerifier": true,
    "oidcPreferredForCloudSync": true
  }
}

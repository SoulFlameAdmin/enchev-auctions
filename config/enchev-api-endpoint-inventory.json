{
  "version": 1,
  "task": "24.09",
  "title": "API endpoint inventory",
  "sourceOfTruth": "packages/contracts/openapi/enchev-api.v1.json",
  "implementationRoot": "app/api",
  "authorityBoundary": "Inventory is descriptive only. PostgreSQL remains authoritative for auction state, accepted bids, winner selection and final results.",
  "endpoints": [
    {
      "method": "DELETE",
      "path": "/api/ea-early-access/admin/session",
      "operationId": "deleteEaEarlyAccessAdminSession",
      "summary": "Clear the early-access admin session cookie"
    },
    {
      "method": "GET",
      "path": "/api/admin/callback",
      "operationId": "finishAdminGoogleOAuth",
      "summary": "Exchange Google authorization code and verify admin allowlist"
    },
    {
      "method": "GET",
      "path": "/api/admin/google",
      "operationId": "beginAdminGoogleOAuth",
      "summary": "Begin administrator-only Google OAuth (PKCE)"
    },
    {
      "method": "GET",
      "path": "/api/admin/session",
      "operationId": "getAdminGoogleSession",
      "summary": "Verify current Google admin session against Supabase Auth"
    },
    {
      "method": "GET",
      "path": "/api/carar-waitlist",
      "operationId": "getCarArWaitlistMethodGuard",
      "summary": "Reject non-POST CarAR waitlist requests"
    },
    {
      "method": "GET",
      "path": "/api/ea-early-access",
      "operationId": "getEaEarlyAccessPublic",
      "summary": "Read public E&A early-access state through the dedicated Supabase edge service"
    },
    {
      "method": "GET",
      "path": "/api/ea-early-access/admin",
      "operationId": "getEaEarlyAccessAdmin",
      "summary": "List early-access signups for an authenticated admin session"
    },
    {
      "method": "GET",
      "path": "/api/ea-early-access/admin/session",
      "operationId": "getEaEarlyAccessAdminSession",
      "summary": "Read sanitized early-access admin session state"
    },
    {
      "method": "GET",
      "path": "/api/enchev-auth/[action]",
      "operationId": "getBuyerAuthSession",
      "summary": "Check authenticated ENCHEV buyer session, fail-closed without dedicated provider"
    },
    {
      "method": "GET",
      "path": "/api/health/api",
      "operationId": "getApiHealth",
      "summary": "API health"
    },
    {
      "method": "GET",
      "path": "/api/health/realtime",
      "operationId": "getRealtimeHealth",
      "summary": "Realtime service readiness"
    },
    {
      "method": "GET",
      "path": "/api/health/redis",
      "operationId": "getRedisHealth",
      "summary": "Sanitized Redis or Valkey binding health"
    },
    {
      "method": "GET",
      "path": "/api/health/redis-env",
      "operationId": "getRedisEnvironmentHealth",
      "summary": "Sanitized Redis-related environment key inventory"
    },
    {
      "method": "GET",
      "path": "/api/health/vercel-oidc-management",
      "operationId": "getVercelOidcManagementHealth",
      "summary": "Sanitized Vercel OIDC management reachability probe"
    },
    {
      "method": "GET",
      "path": "/api/health/web",
      "operationId": "getWebHealth",
      "summary": "Web health"
    },
    {
      "method": "GET",
      "path": "/api/health/worker",
      "operationId": "getWorkerHealth",
      "summary": "Worker service readiness"
    },
    {
      "method": "GET",
      "path": "/api/live-auction-clock",
      "operationId": "getLiveAuctionDemoClock",
      "summary": "Read the server-issued non-authoritative browser-session demo clock"
    },
    {
      "method": "POST",
      "path": "/api/admin/logout",
      "operationId": "logoutAdminGoogleSession",
      "summary": "Revoke Google admin session and clear protected cookies"
    },
    {
      "method": "POST",
      "path": "/api/carar-waitlist",
      "operationId": "postCarArWaitlist",
      "summary": "Join the CarAR launch waitlist using a validated email address"
    },
    {
      "method": "POST",
      "path": "/api/ea-early-access",
      "operationId": "postEaEarlyAccessPublic",
      "summary": "Submit public E&A early-access data to the dedicated Supabase edge service"
    },
    {
      "method": "POST",
      "path": "/api/ea-early-access/admin/session",
      "operationId": "postEaEarlyAccessAdminSession",
      "summary": "Create an early-access admin session using the configured admin secret"
    },
    {
      "method": "POST",
      "path": "/api/enchev-auth/[action]",
      "operationId": "postBuyerAuthAction",
      "summary": "Dedicated-project buyer sign-up, sign-in or sign-out; same-origin only"
    },
    {
      "method": "POST",
      "path": "/api/live-auction-clock",
      "operationId": "postLiveAuctionDemoBid",
      "summary": "Advance the non-authoritative browser-session demo bid feedback"
    }
  ]
}

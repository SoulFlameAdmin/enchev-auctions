# No secrets are required to view the development dashboard.
# Configure independent preview and production Supabase projects.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Optional server-only, read-only GitHub token: contents + actions permissions.
GITHUB_STATUS_TOKEN=
# Optional server-only Vercel token for live deployment state.
VERCEL_STATUS_TOKEN=
